{
  "name": "byok-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A bring-your-own-key coding agent with a real workspace, shell access and a ChatGPT-style UI.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "mock": "node scripts/mock-provider.mjs",
    "test:agent": "npx tsx scripts/test-agent.ts",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
